{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "24",
    "python": "3.12"
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci",
        "python3 -m pip install --no-cache-dir --break-system-packages -r requirements.txt",
        "python3 -m pip install --no-cache-dir --break-system-packages --force-reinstall --no-deps garth-ng"
      ]
    },
    "build": {
      "commands": [
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}
